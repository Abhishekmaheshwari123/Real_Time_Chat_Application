{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ChatDB;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "ConnectHub",
    "Audience": "ConnectHubUsers",
    "Key": "THIS_IS_SUPER_SECRET_KEY_123456789_ABCDEF_1234567890"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:5500",
      "http://localhost:5500",
      "http://127.0.0.1:5501",
      "http://localhost:5501",
      "http://127.0.0.1:5173",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://localhost:3000"
    ]
  },

  "AllowedHosts": "*",
  "AzureStorage": {
    "ConnectionString": "SET_YOUR_AZURE_STORAGE_CONNECTION_STRING_HERE",
    "ContainerName": "chat-media"
  }
}
